{
  "display_information": {
    "name": "OffBoardMe",
    "description": "Asistente de captura y propagación de conocimiento para procesos de offboarding.",
    "background_color": "#18205c"
  },
  "features": {
    "bot_user": {
      "display_name": "OffBoardMe",
      "always_online": true
    }
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "chat:write",
        "im:history",
        "im:write",
        "channels:history",
        "channels:read",
        "users:read",
        "app_mentions:read"
      ]
    }
  },
  "settings": {
    "event_subscriptions": {
      "bot_events": [
        "app_mention",
        "message.im"
      ]
    },
    "interactivity": {
      "is_enabled": true
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": true,
    "token_rotation_enabled": false
  }
}
