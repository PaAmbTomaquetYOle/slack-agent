# Slack Bot Configuration
# Get this token from https://api.slack.com/apps → your app → OAuth & Permissions -> OAuth Tokens
SLACK_BOT_TOKEN=xoxb-your-bot-token
# Get these from https://api.slack.com/apps → your app → Basic Information -> App Credentials / App-Level Tokens
SLACK_SIGNING_SECRET=your-signing-secret
SLACK_APP_TOKEN=xapp-your-app-level-token
SLACK_AGENT_DRY_RUN=false

# Server
PORT=3000
MCP_SERVER_URL=http://localhost:8000/mcp

# Backend API (read-only REST since BE-7; writes go over Kafka)
BACKEND_API_URL=http://localhost:8888/api/v1
# Client-credentials used to fetch a token from POST /auth/token (BE-7). slack-agent no longer
# self-signs its JWT.
BACKEND_CLIENT_ID=slack-agent
BACKEND_CLIENT_SECRET=your-client-secret

# Kafka (leave KAFKA_BROKERS empty to disable Kafka entirely)
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=slack-agent
KAFKA_OUTBOUND_TOPIC_PREFIX=slack-agent
KAFKA_INBOUND_TOPIC_PREFIX=offboarding
KAFKA_CONSUMER_GROUP_ID=slack-agent-consumer
KAFKA_DLQ_TOPIC=slack-agent.dlq
# BE-7: the broker requires SASL_SSL/SCRAM-SHA-512 — PLAINTEXT is no longer accepted.
KAFKA_SASL_MECHANISM=scram-sha-512
KAFKA_SASL_USERNAME=slack-agent
KAFKA_SASL_PASSWORD=your-kafka-password
# Path to a PEM-encoded CA certificate; leave empty to trust the system's default CA store.
KAFKA_SSL_CA=

# Gemini (Google AI Studio) — required for the guided offboarding interview
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# SOP detection (SA-7) — channels to monitor and heuristic thresholds
SOP_MONITORED_CHANNELS=C0123456789,C0987654321
SOP_MIN_MESSAGE_LENGTH=200
SOP_KEYWORDS=deploy,pipeline,credentials,migration,workaround,config,rollback,incident
SOP_MIN_REACTIONS=3

# Handover dossier (SA-4) — channel where the generated dossier is posted / Canvas is created
DOSSIER_MANAGERS_CHANNEL_ID=C0123456789

# Question -> related SOP suggestion (SA-8) — channels to watch and thresholds.
# Defaults to SOP_MONITORED_CHANNELS if unset.
QUESTION_SUGGESTION_MONITORED_CHANNELS=C0123456789,C0987654321
QUESTION_MIN_MESSAGE_LENGTH=15
QUESTION_MAX_SUGGESTIONS=3

# Expert recommendation (SA-9) — /find-expert and "who knows about X?" app mentions
EXPERT_MAX_RESULTS=3
# Base URL shared via /knowledge-graph; defaults to http://localhost:$PORT
KNOWLEDGE_GRAPH_BASE_URL=http://localhost:3000
