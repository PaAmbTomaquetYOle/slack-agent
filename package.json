    "@google/genai": "2.10.0",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@slack/bolt": "4.7.3",
    "axios": "1.18.1",
    "dotenv": "17.4.2",
    "jsonwebtoken": "9.0.3",
    "kafkajs": "2.2.4"
