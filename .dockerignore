# Version control
.git
.gitignore
.github

# Dependencies (installed fresh inside the image)
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.npm
.yarn

# Build output (regenerated by `npm run build` inside the image)
dist
build
*.tsbuildinfo

# Env / secrets - never ship into the build context
.env
.env.*
!.env.example

# Test / coverage
coverage
.nyc_output
src/**/__tests__
src/**/*.test.ts
src/testing

# Editors / IDEs
.vscode
.idea
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Logs
logs
*.log

# Docs / non-runtime assets (not needed inside the image)
docs
README.md
LICENSE

# Claude Code / tooling local config
.claude
.claude-*
.codebase-memory

# Local docker override files
docker-compose*.yml
docker-compose*.yaml
.dockerignore
Dockerfile*
